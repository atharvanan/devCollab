# DevCollab Frontend Environment Variables

# Local Development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Production Deployment (Vercel):
# Set this to your Render backend service URL:
# NEXT_PUBLIC_API_URL=https://devcollab-backend.onrender.com/api/v1
# NEXT_PUBLIC_SOCKET_URL=https://devcollab-backend.onrender.com
